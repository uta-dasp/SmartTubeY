<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container" android:layout_width="match_parent" android:layout_height="48dp"
    android:minHeight="48dp" android:layout_marginBottom="6dp" android:padding="12dp"
    android:background="@drawable/personal_player_option_background" android:clickable="true"
    android:focusable="true" android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@android:id/title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="15sp" android:fontFamily="sans-serif-medium"
        android:textColor="@color/personal_player_option_text" android:duplicateParentState="true" android:includeFontPadding="false"
        android:maxLines="1" android:ellipsize="end" />
    <CheckBox android:id="@+id/button" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="12dp" android:focusable="false" android:clickable="false"
        android:buttonTint="#B3B3B3" android:background="@null" />
</LinearLayout>
