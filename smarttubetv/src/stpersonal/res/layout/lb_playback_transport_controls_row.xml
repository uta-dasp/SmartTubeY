<?xml version="1.0" encoding="utf-8"?>
<!-- Presentation overlay only: all upstream transport, seek, progress and action IDs are retained. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="374dp"
    android:clipChildren="false" android:clipToPadding="false">

    <LinearLayout android:id="@+id/controls_card" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:orientation="horizontal" android:clipToPadding="false">
        <ImageView android:id="@+id/image" android:layout_width="0dp" android:layout_height="0dp" />
        <FrameLayout android:id="@+id/description_dock" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:clipToPadding="false" />
    </LinearLayout>

    <LinearLayout android:id="@+id/thumbs_row_wrapper" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginBottom="100dp" android:orientation="vertical" android:visibility="invisible">
        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.seekpreview.ThumbsBar
            android:id="@+id/thumbs_row" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" />
        <TextView android:id="@+id/thumbs_row_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:textColor="#F1F1F1" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>

    <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView
        android:id="@+id/transport_row" android:layout_width="match_parent" android:layout_height="100dp"
        android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="48dp"
        android:paddingEnd="48dp" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/top_edge" android:layout_width="match_parent"
            android:layout_height="1dp" android:focusable="true" android:orientation="horizontal" />
        <RelativeLayout android:id="@+id/time_info" android:layout_width="match_parent"
            android:layout_height="18dp" android:layoutDirection="ltr">
            <TextView android:id="@+id/current_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_alignParentStart="true"
                android:textColor="#B3B3B3" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/total_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_alignParentEnd="true"
                android:textColor="#B3B3B3" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/ending_time" android:layout_width="0dp" android:layout_height="0dp" />
        </RelativeLayout>
        <com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.misc.SeekBar
            android:id="@+id/playback_progress" android:layout_width="match_parent"
            android:layout_height="16dp" android:focusable="true" android:focusableInTouchMode="true" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:clipChildren="false" android:clipToPadding="false">
            <FrameLayout android:id="@+id/secondary_controls_dock" android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <FrameLayout android:id="@+id/controls_dock" android:layout_width="180dp"
                android:layout_height="match_parent" android:layout_gravity="center" />
        </FrameLayout>
        <RelativeLayout android:id="@+id/additional_info" android:layout_width="0dp" android:layout_height="0dp">
            <TextView android:id="@+id/quality_info" android:layout_width="0dp" android:layout_height="0dp" />
            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.time.DateTimeView
                android:id="@+id/date_time" android:layout_width="0dp" android:layout_height="0dp" />
        </RelativeLayout>
    </com.liskovsoft.smartyoutubetv2.tv.ui.mod.leanback.playerglue.tweaks.PlaybackTransportRowView>
</FrameLayout>
