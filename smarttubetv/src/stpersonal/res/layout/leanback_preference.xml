<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidX preference binding IDs retained; presentation for the personal flavor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:layout_marginBottom="6dp" android:paddingStart="16dp"
    android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@drawable/personal_player_option_background" android:clickable="true"
    android:focusable="true" android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:id="@+id/icon_frame" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:duplicateParentState="true">
        <androidx.appcompat.widget.AppCompatImageView android:id="@android:id/icon" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginEnd="14dp" app:tint="@color/personal_player_option_text" android:duplicateParentState="true" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:duplicateParentState="true">
        <TextView android:id="@android:id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="15sp"
            android:textColor="@color/personal_player_option_text" android:duplicateParentState="true" />
        <TextView android:id="@android:id/summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="10sp"
            android:textColor="@color/personal_player_option_summary" android:duplicateParentState="true"
            android:maxLines="3" android:layout_marginTop="2dp" />
    </LinearLayout>
    <LinearLayout android:id="@android:id/widget_frame" android:layout_width="wrap_content"
        android:layout_height="match_parent" android:gravity="center_vertical"
        android:layout_marginStart="8dp" android:orientation="vertical" />
</LinearLayout>
